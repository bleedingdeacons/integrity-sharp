<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
	  
    <!-- Package Info -->
    <PackageId>Integrity.Client</PackageId>
    <Version>1.10.3</Version>
    <Authors>The Bleeding Deacons</Authors>
    <Company>The Bleeding Deacons</Company>
    <Product>Integrity API Client</Product>
    <Description>C# client library for the Integrity WordPress API. Provides secure access to Groups and Meetings data.</Description>
    <PackageTags>wordpress;api;client;integrity;unity</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/bleedingdeacons/integrity-sharp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/bleedingdeacons/integrity-sharp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build Settings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Copyright>Don't take yourself too damn seriously</Copyright>
    <Platforms>AnyCPU</Platforms>

    <!-- PDBs live inside the assembly, so the single .nupkg is debuggable without
         a symbol server (GitHub Packages doesn't host one). Combined with Source
         Link — built into the .NET SDK for GitHub-hosted repos — a consumer can
         step into this code straight from the package. -->
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!-- Models is not published as its own package, but its types (Group, Meeting,
       Member, …) appear in this library's public API, so its assembly has to ship
       inside this .nupkg. PrivateAssets="all" stops NuGet emitting a dependency on
       a package that doesn't exist; the target below then copies the built
       Models.dll into lib/<tfm>/ alongside the client. Without both halves the
       package restores cleanly and then throws TypeLoadException at runtime. -->
  <ItemGroup>
    <ProjectReference Include="..\TheBleedingDeacons.Unity.Models\TheBleedingDeacons.Unity.Models.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeModelsAssemblyInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeModelsAssemblyInPackage">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == '' AND '%(Filename)' == 'TheBleedingDeacons.Unity.Models'" />
    </ItemGroup>
  </Target>

</Project>
