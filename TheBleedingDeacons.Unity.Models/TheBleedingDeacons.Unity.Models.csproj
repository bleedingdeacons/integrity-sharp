<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Copyright>Don't take yourself too damn seriously</Copyright>
    <Platforms>AnyCPU</Platforms>

    <!-- This assembly ships bundled inside the Integrity.Client package rather
         than on its own, so it takes its version from whatever the release build
         passes down (the git tag) instead of pinning one here, and embeds its
         PDB so the bundled DLL stays debuggable. IsPackable guards against a
         stray `dotnet pack` on the solution publishing it as its own package. -->
    <DebugType>embedded</DebugType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
